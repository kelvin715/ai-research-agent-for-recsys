+def _user_tab_keys(users, tabs, dtype=None):
+    users = np.asarray(users)
+    tabs = np.asarray(tabs)
+    if dtype is None:
+        dtype = np.dtype([('user', users.dtype), ('tab', tabs.dtype)])
+    keys = np.empty(users.shape[0], dtype=dtype)
+    keys['user'] = users
+    keys['tab'] = tabs
+    return keys
+
+
+def _frozen_user_tab_features(rowset, pair_keys, pair_sum, pair_count,
+                              global_rate):
+    query = _user_tab_keys(rowset.user_id, rowset.tab, pair_keys.dtype)
+    positions = np.searchsorted(pair_keys, query)
+    matched = np.zeros(query.shape[0], dtype=bool)
+    in_range_rows = np.flatnonzero(positions < pair_keys.shape[0])
+    if in_range_rows.size:
+        matched[in_range_rows] = (
+            pair_keys[positions[in_range_rows]] == query[in_range_rows]
+        )
+
+    sums = np.zeros(query.shape[0], dtype=np.float64)
+    counts = np.zeros(query.shape[0], dtype=np.float64)
+    if np.any(matched):
+        source = positions[matched]
+        sums[matched] = pair_sum[source]
+        counts[matched] = pair_count[source]
+
+    rate = (sums + 10.0 * global_rate) / (counts + 10.0)
+    return np.column_stack((rate, np.log1p(counts))).astype(np.float32)
+
