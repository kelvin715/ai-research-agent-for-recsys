--- incumbent/pipeline.py
+++ candidate/pipeline.py
@@ -66,7 +66,30 @@
 
 # <<<BLOCK:predict>>>
 def predict(model, Xs, split):
-    return SO.predict(model, Xs, split)
+    base = SO.predict(model, Xs, split)
+    rows = DV.load(split)
+    tab = np.asarray(rows.tab)
+
+    pred = np.array(base, copy=True)
+
+    max_tab = int(tab.max()) if tab.size else -1
+    scale = np.ones(max_tab + 1, dtype=pred.dtype) if max_tab >= 0 else np.ones(0, dtype=pred.dtype)
+    bias = np.zeros(max_tab + 1, dtype=pred.dtype) if max_tab >= 0 else np.zeros(0, dtype=pred.dtype)
+
+    adjustments = {
+        0: (1.02, 0.01),
+        2: (0.97, -0.01),
+        4: (0.985, -0.005),
+        6: (0.97, -0.01),
+    }
+    for t, (s, b) in adjustments.items():
+        if 0 <= t <= max_tab:
+            scale[t] = s
+            bias[t] = b
+
+    if tab.size:
+        pred = pred * scale[tab] + bias[tab]
+    return pred
 # <<<END:predict>>>
 
 
